{
  "id": "fridge.have_snack",
  "name": "Have Snack",
  "ad": { "hunger": 40 },
  "cost": 5,
  "requires": ["object.notBroken"],
  "slot": 0,
  "states": {
    "start": { "do": "anim:open_fridge", "durationMin": 1, "next": "eat" },
    "eat": {
      "do": "anim:eat",
      "perMin": { "hunger": 8 },
      "untilMotive": { "motive": "hunger", "gte": 90 },
      "next": "finish"
    },
    "finish": { "do": "spawnAt:dirty_plate", "next": "$exit" }
  },
  "interruptible": { "below": { "bladder": -85 } }
}
